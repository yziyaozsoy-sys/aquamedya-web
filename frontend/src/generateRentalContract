import jsPDF from 'jspdf';
import autoTable from 'jspdf-autotable';

// Türkçe Karakterleri jsPDF Uyumlu Temiz Harflere Dönüştürücü
const fixTr = (text) => {
  if (!text) return '';
  return String(text)
    .replace(/ğ/g, 'g').replace(/Ğ/g, 'G')
    .replace(/ü/g, 'u').replace(/Ü/g, 'U')
    .replace(/ş/g, 's').replace(/Ş/g, 'S')
    .replace(/ı/g, 'i').replace(/İ/g, 'I')
    .replace(/ö/g, 'o').replace(/Ö/g, 'O')
    .replace(/ç/g, 'c').replace(/Ç/g, 'C');
};

export const generateRentalPDF = (req) => {
  const doc = new jsPDF();

  // --- ÜST BANNER (Slate-900) ---
  doc.setFillColor(15, 23, 42);
  doc.rect(0, 0, 210, 36, 'F');

  // Modern Vektörel Logo Rozeti (Sol Üst)
  doc.setFillColor(8, 145, 178); // Cyan-600
  doc.roundedRect(14, 8, 18, 18, 3, 3, 'F');
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(11);
  doc.setFont('helvetica', 'bold');
  doc.text('AQ', 17.5, 20);

  // Başlıklar
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(14);
  doc.setFont('helvetica', 'bold');
  doc.text(fixTr('EKIPMAN KIRALAMA VE TESLIM TUTANAGI'), 38, 18);

  doc.setFontSize(8.5);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(148, 163, 184); // Slate-400
  doc.text(fixTr('AQUA MEDYA TICARET LIMITED SIRKETI'), 38, 25);

  const contractNo = `KRL-${(req._id || req.id || Date.now().toString()).slice(-6).toUpperCase()}`;
  doc.setFontSize(8);
  doc.setTextColor(255, 255, 255);
  doc.text(fixTr(`Belge No : ${contractNo}`), 145, 17);
  doc.text(fixTr(`Tarih    : ${new Date().toLocaleDateString('tr-TR')}`), 145, 23);

  // --- TARAFLAR KUTUSU ---
  doc.setTextColor(30, 41, 59);
  doc.setFontSize(9);
  doc.setFont('helvetica', 'bold');
  doc.text(fixTr('KIRALAYAN (FIRMA BILGILERI):'), 14, 46);
  doc.text(fixTr('KIRALAYAN MUSTERI / KURUM:'), 110, 46);

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(8);
  doc.setTextColor(51, 65, 85);
  doc.text([
    fixTr('AQUA MEDYA TIC. LTD. STI.'),
    fixTr('Merkez Mah. Seckin Sok. Z Ofis No:2-4/90'),
    fixTr('Kagithane / ISTANBUL'),
    fixTr('Tel: 0 212 325 25 25 / GSM: 0 532 011 01 01'),
    fixTr('E-posta: info@aquamedya.com.tr')
  ], 14, 52);

  // Müşteri Bilgilerini Kapsamlı Çözümleme (Tüm olası anahtarlar taranır)
  const customerName = req.customer || req.name || req.customerName || req.userName || 'Musteri Belirtilmedi';
  const customerPhone = req.phone || req.telephone || req.tel || req.customerPhone || req.userPhone || req.memberPhone || '-';
  const customerEmail = req.email || req.mail || req.customerEmail || req.userEmail || '-';
  const rentalDate = `${req.date || '-'} ${req.time ? `(${req.time})` : ''}`;
  const deliveryPlace = req.location === 'MERKEZDEN_TESLIM' ? 'Merkezden Kendisi Alacak' : (req.location || 'Ofisten Teslim');

  doc.text([
    fixTr(`Ad Soyad / Firma: ${customerName}`),
    fixTr(`Telefon          : ${customerPhone}`),
    fixTr(`E-posta          : ${customerEmail}`),
    fixTr(`Teslimat Yeri    : ${deliveryPlace}`),
    fixTr(`Kiralama Tarihi  : ${rentalDate}`)
  ], 110, 52);

  // Çizgi
  doc.setDrawColor(226, 232, 240);
  doc.line(14, 76, 196, 76);

  // --- EKİPMAN LİSTESİ TABLOSU ---
  let rawItems = [];
  if (Array.isArray(req.item)) rawItems = req.item;
  else if (typeof req.item === 'string') rawItems = req.item.split(',').map(s => s.trim());
  else if (Array.isArray(req.equipment)) rawItems = req.equipment;

  const tableBody = rawItems.length > 0
    ? rawItems.map((item, idx) => {
        const title = typeof item === 'string' ? item : (item.name || 'Ekipman');
        return [
          (idx + 1).toString(),
          fixTr(title),
          '1 Adet',
          fixTr('Eksiksiz / Test Edildi - Calisir Durumda')
        ];
      })
    : [['1', fixTr('Secili Kiralama Ekipmanlari'), '1 Paket', fixTr('Calisir Durumda')]];

  autoTable(doc, {
    startY: 81,
    head: [[fixTr('#'), fixTr('Ekipman / Urun Tanimi'), fixTr('Adet'), fixTr('Teslimat ve Calisma Durumu')]],
    body: tableBody,
    theme: 'grid',
    headStyles: { fillColor: [8, 145, 178], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 8 },
    styles: { fontSize: 8, cellPadding: 3.5 },
    alternateRowStyles: { fillColor: [248, 250, 252] }
  });

  const finalY = (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 8 : 140;

  // Müşteri Notu varsa ekle
  if (req.notes) {
    doc.setFontSize(7.5);
    doc.setFont('helvetica', 'italic');
    doc.setTextColor(100, 116, 139);
    doc.text(fixTr(`Musteri Ozel Notu: ${req.notes}`), 14, finalY);
  }

  const termsY = req.notes ? finalY + 7 : finalY;

  // --- SÖZLEŞME VE TAAHHÜT ŞARTLARI ---
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(30, 41, 59);
  doc.text(fixTr('KIRALAMA VE TESLIM TAAHHUTLERI:'), 14, termsY);

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(7);
  doc.setTextColor(71, 85, 105);
  const terms = [
    fixTr('1. Kiralayan musteri, yukarida belirtilen ekipmanlari fiziki ve calisma kontrollerini yaparak eksiksiz teslim almistir.'),
    fixTr('2. Kullanim sirasinda meydana gelebilecek ariza, kirilma, hasar veya sivi temasi masraflari kiralayana aittir.'),
    fixTr('3. Belirtilen teslim saatinde iade edilmeyen ekipmanlar icin gecikilen her gun/saat cari kiralama bedeli tahakkuk ettirilir.'),
    fixTr('4. Isbu sozlesme tutanagi taraflarca okunup mutabik kalinarak 2 (iki) nusha halinde imza altina alinmistir.')
  ];
  doc.text(terms, 14, termsY + 5);

  // --- İMZA ALANI ---
  const signY = termsY + 28;
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(30, 41, 59);
  doc.text(fixTr('TESLIM EDEN (Aqua Medya Yetkilisi)'), 20, signY);
  doc.text(fixTr('TESLIM ALAN (Musteri / Kase & Imza)'), 120, signY);

  doc.setFont('helvetica', 'normal');
  doc.text('Imza: _______________________', 20, signY + 12);
  doc.text('Imza: _______________________', 120, signY + 12);

  // İndirme
  const safeCustomer = fixTr(customerName).replace(/[^a-zA-Z0-9]/g, '_');
  doc.save(`AquaMedya_${contractNo}_${safeCustomer}.pdf`);
};
