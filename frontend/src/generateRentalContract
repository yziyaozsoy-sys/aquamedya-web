import jsPDF from 'jspdf';
import autoTable from 'jspdf-autotable';

export const generateRentalPDF = (order) => {
  const doc = new jsPDF();

  // --- ÜST BANNER (Slate-900) ---
  doc.setFillColor(15, 23, 42);
  doc.rect(0, 0, 210, 36, 'F');

  doc.setTextColor(255, 255, 255);
  doc.setFontSize(16);
  doc.setFont('helvetica', 'bold');
  doc.text('EKIPMAN KIRALAMA VE TESLIM TUTANAGI', 14, 18);

  doc.setFontSize(9);
  doc.setFont('helvetica', 'normal');
  doc.text('AQUA MEDYA TICARET LIMITED SIRKETI', 14, 25);

  const contractNo = `KRL-${(order._id || order.id || Date.now().toString()).slice(-6).toUpperCase()}`;
  doc.setFontSize(8);
  doc.text(`Belge No : ${contractNo}`, 145, 17);
  doc.text(`Duzenleme: ${new Date().toLocaleDateString('tr-TR')}`, 145, 23);

  // --- TARAFLAR BİLGİ KUTUSU ---
  doc.setTextColor(30, 41, 59);
  doc.setFontSize(9);
  doc.setFont('helvetica', 'bold');
  doc.text('KIRALAYAN (FIRMA):', 14, 46);
  doc.text('KIRALAYAN MUSTERI / KURUM:', 110, 46);

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(8);
  doc.text([
    'AQUA MEDYA TIC. LTD. STI.',
    'Merkez Mah. Seckin Sok. Z Ofis No:2-4/90',
    'Kagithane / ISTANBUL',
    'Tel: 0 212 325 25 25 / info@aquamedya.com.tr'
  ], 14, 52);

  const customerName = order.name || order.customerName || order.userName || 'Musteri Belirtilmedi';
  const customerPhone = order.phone || order.customerPhone || '-';
  const rentalDate = order.date ? `${order.date} ${order.time || ''}` : (order.startDate ? `${order.startDate} - ${order.endDate}` : '-');
  const deliveryPlace = order.deliveryLocation || order.deliveryType || 'Ofisten Teslim';

  doc.text([
    `Yetkili: ${customerName}`,
    `Telefon: ${customerPhone}`,
    `Teslim Yeri: ${deliveryPlace}`,
    `Kiralama Tarihi: ${rentalDate}`
  ], 110, 52);

  // Çizgi
  doc.setDrawColor(226, 232, 240);
  doc.line(14, 73, 196, 73);

  // --- EKİPMAN LİSTESİ TABLOSU ---
  let rawItems = [];
  if (Array.isArray(order.equipment)) rawItems = order.equipment;
  else if (Array.isArray(order.item)) rawItems = order.item;
  else if (typeof order.item === 'string') rawItems = order.item.split(',').map(s => s.trim());
  else if (typeof order.equipment === 'string') rawItems = order.equipment.split(',').map(s => s.trim());

  const tableBody = rawItems.length > 0
    ? rawItems.map((item, idx) => {
        const title = typeof item === 'string' ? item : (item.name || 'Ekipman');
        return [
          (idx + 1).toString(),
          title,
          '1 Adet',
          'Eksiksiz / Test Edildi - Calisir Durumda'
        ];
      })
    : [['1', 'Secili Kiralama Ekipmanlari', '1 Paket', 'Calisir Durumda']];

  autoTable(doc, {
    startY: 78,
    head: [['#', 'Ekipman / Urun Tanimi', 'Adet', 'Teslimat ve Fiziksel Durumu']],
    body: tableBody,
    theme: 'grid',
    headStyles: { fillColor: [8, 145, 178], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 8 },
    styles: { fontSize: 8, cellPadding: 3.5 },
    alternateRowStyles: { fillColor: [248, 250, 252] }
  });

  const finalY = (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 10 : 140;

  // --- SÖZLEŞME VE TAAHHÜT ŞARTLARI ---
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.text('KIRALAMA VE TESLIM TAAHHUTLERI:', 14, finalY);

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(7);
  const terms = [
    '1. Kiralayan musteri, yukarida belirtilen ekipmanlari fiziki ve teknik muayenesini yaparak eksiksiz teslim almistir.',
    '2. Kullanim esnasinda olusabilecek ariza, darbe, sivi temasi ve hasarlardan dogacak masraflar kiralayan tarafindan karsilanir.',
    '3. Ekipmanin suresi icerisinde iade edilmemesi durumunda her gecikilen gun icin cari kiralama bedeli tahakkuk ettirilir.',
    '4. Isbu tutanak 2 (iki) nusha olarak tanzim edilmis ve taraflarca imza altina alinmistir.'
  ];
  doc.text(terms, 14, finalY + 5);

  // --- İMZA ALANI ---
  const signY = finalY + 28;
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.text('TESLIM EDEN (Aqua Medya Yetkilisi)', 20, signY);
  doc.text('TESLIM ALAN (Musteri / Kase & Imza)', 120, signY);

  doc.setFont('helvetica', 'normal');
  doc.text('Imza: _______________________', 20, signY + 12);
  doc.text('Imza: _______________________', 120, signY + 12);

  // Dosyayı İndir
  const safeCustomer = (customerName || 'Musteri').replace(/[^a-zA-Z0-9]/g, '_');
  doc.save(`AquaMedya_Kiralama_${contractNo}_${safeCustomer}.pdf`);
};
