import jsPDF from 'jspdf';
import autoTable from 'jspdf-autotable';

// Türkçe karakterleri standart Latin harflerine çevirerek bozulmayı önler
const fixTr = (text) => {
  if (!text) return '';
  return String(text)
    .replace(/ğ/g, 'g').replace(/Ğ/g, 'G')
    .replace(/ü/g, 'u').replace(/Ü/g, 'U')
    .replace(/ş/g, 's').replace(/Ş/g, 'S')
    .replace(/ı/g, 'i').replace(/İ/g, 'I')
    .replace(/ö/g, 'o').replace(/Ö/g, 'O')
    .replace(/ç/g, 'c').replace(/Ç/g, 'C');
};

// public/logo.png dosyasını Base64'e çeviren yardımcı fonksiyon
const loadLogoBase64 = () => {
  return new Promise((resolve) => {
    const img = new Image();
    img.crossOrigin = 'Anonymous';
    img.src = '/logo.png';
    img.onload = () => {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        resolve(canvas.toDataURL('image/png'));
      } catch (e) {
        resolve(null);
      }
    };
    img.onerror = () => resolve(null);
  });
};

export const generateRentalPDF = async (req) => {
  const doc = new jsPDF();

  // --- ÜST BANNER (Slate-900) ---
  doc.setFillColor(15, 23, 42);
  doc.rect(0, 0, 210, 36, 'F');

  // Logoyu Yerleştir
  const logoData = await loadLogoBase64();
  if (logoData) {
    try {
      doc.addImage(logoData, 'PNG', 14, 8, 20, 20);
    } catch (e) {
      // Logo yüklenemezse yedek kutu
      doc.setFillColor(8, 145, 178);
      doc.roundedRect(14, 8, 18, 18, 3, 3, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(10);
      doc.setFont('helvetica', 'bold');
      doc.text('AQUA', 16, 20);
    }
  } else {
    doc.setFillColor(8, 145, 178);
    doc.roundedRect(14, 8, 18, 18, 3, 3, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(10);
    doc.setFont('helvetica', 'bold');
    doc.text('AQUA', 16, 20);
  }

  // Başlıklar
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(14);
  doc.setFont('helvetica', 'bold');
  doc.text(fixTr('EKİPMAN KİRALAMA VE TESLİM TUTANAGI'), 38, 18);

  doc.setFontSize(8.5);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(148, 163, 184);
  doc.text(fixTr('AQUA MEDYA TİCARET LİMİTED ŞİRKETİ'), 38, 25);

  const contractNo = `KRL-${(req._id || req.id || Date.now().toString()).slice(-6).toUpperCase()}`;
  doc.setFontSize(8);
  doc.setTextColor(255, 255, 255);
  doc.text(fixTr(`Belge No : ${contractNo}`), 145, 17);
  doc.text(fixTr(`Tarih    : ${new Date().toLocaleDateString('tr-TR')}`), 145, 23);

  // --- TARAFLAR KUTUSU ---
  doc.setTextColor(30, 41, 59);
  doc.setFontSize(9);
  doc.setFont('helvetica', 'bold');
  doc.text(fixTr('KİRALAYAN (FİRMA BİLGİLERİ):'), 14, 46);
  doc.text(fixTr('KİRALAYAN MÜŞTERİ / KURUM:'), 110, 46);

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(8);
  doc.setTextColor(51, 65, 85);
  doc.text([
    fixTr('AQUA MEDYA TİC. LTD. STİ.'),
    fixTr('Merkez Mah. Seçkin Sok. Z Ofis No:2-4/90'),
    fixTr('Kağıthane / İSTANBUL'),
    fixTr('Tel: 0 212 325 25 25 / GSM: 0 532 011 01 01'),
    fixTr('E-posta: info@aquamedya.com.tr')
  ], 14, 52);

  // Müşteri İsmi ve Telefon Çözümleme
  let rawCustomer = req.customer || req.name || req.customerName || req.userName || 'Musteri Belirtilmedi';
  let extractedPhone = req.phone || req.telephone || req.tel || req.customerPhone || req.userPhone || req.memberPhone || '';

  // Eğer telefon ayrı alanda yoksa ve müşteri adı "y.ziyaozsoy (05357408103)" şeklindeyse:
  const phoneMatch = rawCustomer.match(/\((.*?)\)/);
  if (phoneMatch && phoneMatch[1]) {
    if (!extractedPhone || extractedPhone === '-') {
      extractedPhone = phoneMatch[1].trim();
    }
    rawCustomer = rawCustomer.replace(/\(.*?\)/, '').trim();
  }

  const customerEmail = req.email || req.mail || req.customerEmail || req.userEmail || '-';
  const rentalDate = `${req.date || '-'} ${req.time ? `(${req.time})` : ''}`;
  const deliveryPlace = req.location === 'MERKEZDEN_TESLİM' ? 'Merkezden Kendisi Alacak' : (req.location || 'Ofisten Teslim');

  doc.text([
    fixTr(`Ad Soyad / Firma: ${rawCustomer}`),
    fixTr(`Telefon          : ${extractedPhone || '-'}`),
    fixTr(`E-posta          : ${customerEmail}`),
    fixTr(`Teslimat Yeri    : ${deliveryPlace}`),
    fixTr(`Kiralama Tarihi  : ${rentalDate}`)
  ], 110, 52);

  // Çizgi
  doc.setDrawColor(226, 232, 240);
  doc.line(14, 76, 196, 76);

  // --- EKİPMAN LİSTESİ TABLOSU ---
  let rawItems = [];
  if (Array.isArray(req.item)) rawItems = req.item;
  else if (typeof req.item === 'string') rawItems = req.item.split(',').map(s => s.trim());
  else if (Array.isArray(req.equipment)) rawItems = req.equipment;

  const tableBody = rawItems.length > 0
    ? rawItems.map((item, idx) => {
        const title = typeof item === 'string' ? item : (item.name || 'Ekipman');
        return [
          (idx + 1).toString(),
          fixTr(title),
          '1 Adet',
          fixTr('Eksiksiz / Test Edildi - Calisir Durumda')
        ];
      })
    : [['1', fixTr('Seçili Kiralama Ekipmanları'), '1 Paket', fixTr('Çalışır Durumda')]];

  autoTable(doc, {
    startY: 81,
    head: [[fixTr('#'), fixTr('Ekipman / Ürün Tanımı'), fixTr('Adet'), fixTr('Teslimat ve Çalışma Durumu')]],
    body: tableBody,
    theme: 'grid',
    headStyles: { fillColor: [8, 145, 178], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 8 },
    styles: { fontSize: 8, cellPadding: 3.5 },
    alternateRowStyles: { fillColor: [248, 250, 252] }
  });

  const finalY = (doc.lastAutoTable && doc.lastAutoTable.finalY) ? doc.lastAutoTable.finalY + 8 : 140;

  if (req.notes) {
    doc.setFontSize(7.5);
    doc.setFont('helvetica', 'italic');
    doc.setTextColor(100, 116, 139);
    doc.text(fixTr(`Müşteri Özel Notu: ${req.notes}`), 14, finalY);
  }

  const termsY = req.notes ? finalY + 7 : finalY;

  // --- SÖZLEŞME VE TAAHHÜT ŞARTLARI ---
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(30, 41, 59);
  doc.text(fixTr('KİRALAMA VE TESLİM TAAHHÜTLERİ:'), 14, termsY);

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(7);
  doc.setTextColor(71, 85, 105);
  const terms = [
    fixTr('1. Kiralayan müşteri, yukarıda belirtilen ekipmanlari fiziki ve çalışma kontrollerini yaparak eksiksiz teslim almıştır.'),
    fixTr('2. Kullanim sirasinda meydana gelebilecek ariza, kirilma, hasar veya sivi temasi masraflari kiralayana aittir.'),
    fixTr('3. Belirtilen teslim saatinde iade edilmeyen ekipmanlar icin gecikilen her gun/saat cari kiralama bedeli tahakkuk ettirilir.'),
    fixTr('4. Isbu sozlesme tutanagi taraflarca okunup mutabik kalinarak 2 (iki) nusha halinde imza altina alinmistir.')
  ];
  doc.text(terms, 14, termsY + 5);

  // --- İMZA ALANI ---
  const signY = termsY + 28;
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(30, 41, 59);
  doc.text(fixTr('TESLİM EDEN (Aqua Medya Yetkilisi)'), 20, signY);
  doc.text(fixTr('TESLİM ALAN (Müşteri / Kase & Imza)'), 120, signY);

  doc.setFont('helvetica', 'normal');
  doc.text('Imza: _______________________', 20, signY + 12);
  doc.text('Imza: _______________________', 120, signY + 12);

  const safeCustomer = fixTr(rawCustomer).replace(/[^a-zA-Z0-9]/g, '_');
  doc.save(`AquaMedya_${contractNo}_${safeCustomer}.pdf`);
};
